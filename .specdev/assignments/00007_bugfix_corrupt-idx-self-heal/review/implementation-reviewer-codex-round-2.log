                expected_end = index_dict[keys[-1]] + len(last_line)
                actual_size = os.path.getsize(jsonl_file_path)
                if expected_end == actual_size:
                    return True

    sorted_keys = sorted(keys, key=str)
    tmp_path = jsonl_file_path + '.tmp'

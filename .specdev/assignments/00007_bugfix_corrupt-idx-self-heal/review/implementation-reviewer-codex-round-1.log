# --- Self-heal of empty/corrupt .idx (00007) -------------------------------

def test_empty_idx_self_heals_on_read_and_write(test_file, sample_data, capsys):
    """An existing-but-empty .idx is rebuilt (not crashed on) and a WARNING is emitted.

    Reproduces the production case: an interrupted write leaves a zero-length
    .idx with a fresh mtime, so the mtime gate would otherwise trust it.
    """
    save_jsonl(test_file, sample_data)
    idx = test_file + ".idx"

    # Truncate the index to zero bytes, then make its mtime fresher than the data
    open(idx, "w").close()
    assert os.path.getsize(idx) == 0
    os.utime(idx, None)  # fresh mtime -> mtime gate alone would trust it

    # Read path heals instead of raising orjson "zero-length empty document".
    # Use a bounded select so it goes through the index (an unbounded select
    # short-circuits to load_jsonl, which does not read the .idx at all).
    selected = select_jsonl(test_file, lower_key="key1", upper_key="key3")
    assert selected == sample_data
    assert os.path.getsize(idx) > 0  # rebuilt

    # WARNING surfaced (incident was silent)
    assert "WARNING: rebuilt empty index" in capsys.readouterr().out

    # Write path also heals from an empty index
    open(idx, "w").close()
    os.utime(idx, None)
    update_jsonl(test_file, {"key4": {"value": 4, "name": "test4"}})
    assert load_jsonl(test_file)["key4"]["value"] == 4


def test_corrupt_idx_self_heals_via_load_index_and_lint_force(test_file, sample_data, capsys):
    """A non-empty garbage .idx is rebuilt by load_index and by lint_jsonl(force=True)."""
    from jsonldb.jsonlfile import load_index
    save_jsonl(test_file, sample_data)
    idx = test_file + ".idx"

    # Non-empty but unparseable, with a fresh mtime
    with open(idx, "wb") as f:
        f.write(b"not valid json at all")
    os.utime(idx, None)

    # load_index recovers and returns the correct key set
    recovered = load_index(test_file)
    assert set(recovered.keys()) == set(sample_data.keys())
    assert "WARNING: rebuilt corrupt index" in capsys.readouterr().out

    # The maintenance/lint full path also recovers instead of crashing
    with open(idx, "wb") as f:
        f.write(b"garbage")
    os.utime(idx, None)
    assert lint_jsonl(test_file, force=True) is True
    assert load_jsonl(test_file) == sample_data


def test_valid_idx_not_spuriously_rebuilt(test_file, sample_data, capsys, monkeypatch):
    """A valid, fresh .idx is neither rebuilt nor warned about."""
    import jsonldb.jsonlfile as jf
    save_jsonl(test_file, sample_data)
    idx = test_file + ".idx"
    mtime_before = os.path.getmtime(idx)

    calls = []
    real_build = jf.build_jsonl_index
    monkeypatch.setattr(jf, "build_jsonl_index", lambda p: calls.append(p) or real_build(p))

    result = jf.load_index(test_file)
    assert set(result.keys()) == set(sample_data.keys())
    assert calls == []                                   # no rebuild
    assert os.path.getmtime(idx) == mtime_before         # untouched
    assert "WARNING" not in capsys.readouterr().out      # silent

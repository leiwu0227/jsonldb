# --- Self-heal of empty/corrupt .idx across folderdb + visual (00007) -------

def test_corrupt_idx_self_heals_in_meta_and_delete_range(test_folder, sample_dict, capsys):
    """build_dbmeta (_make_meta_entry) and delete_file_range recover from a
    non-empty garbage .idx instead of crashing on orjson.loads."""
    db = FolderDB(test_folder)
    db.upsert_dict("test1", sample_dict)
    idx = db._get_file_path("test1") + ".idx"

    # Corrupt the index (parseable-as-bytes garbage) with a fresh mtime so the
    # mtime gate alone would trust it.
    with open(idx, "wb") as f:
        f.write(b"garbage not json")
    os.utime(idx, None)

    # _make_meta_entry path heals and reports the correct count
    db.build_dbmeta()
    meta = select_jsonl(os.path.join(db.folder_path, "db.meta"))
    assert meta["test1"]["count"] == 3
    assert "WARNING: rebuilt corrupt index" in capsys.readouterr().out

    # delete_file_range path heals too
    with open(idx, "wb") as f:
        f.write(b"still garbage")
    os.utime(idx, None)
    db.delete_file_range("test1", "key1", "key2")
    remaining = db.get_dict(["test1"])["test1"]
    assert set(remaining.keys()) == {"key3"}


def test_visual_index_reads_route_through_load_index(test_folder, sample_dict):
    """visual.py no longer reads .idx directly; its load_index recovers a corrupt
    index instead of raising (covers the visualization paths without rendering)."""
    import jsonldb.visual as visual

    # No raw index-loading strategy remains in the visualization module

   169	def lint_jsonl(jsonl_file_path: str, force: bool = False) -> bool:
   170	    """Clean and optimize a JSONL file.
   171	
   172	    Uses stream-based approach to avoid loading entire file into memory.
   173	    Skips rewrite if file is already sorted and compact.
   174	
   175	    When force=False (default), skips the expensive mmap line-count scan
   176	    if the index file is at least as recent as the data file.
   177	
   178	    Args:
   179	        jsonl_file_path: Path to the JSONL file to optimize
   180	        force: If True, always run full mmap line-count verification
   181	
   182	    Returns:
   183	        bool: True if file exists (whether skipped or linted), False if not found
   184	    """
   185	    if not os.path.exists(jsonl_file_path):
   186	        return False
   187	
   188	    if os.path.getsize(jsonl_file_path) == 0:
   189	        ensure_index_exists(jsonl_file_path)
   190	        return True
   191	
   192	    ensure_index_exists(jsonl_file_path)
   193	
   194	    index_path = jsonl_file_path + ".idx"
   195	
   196	    # Fast path: skip mmap scan when index is fresh
   197	    if not force:
   198	        idx_mtime = os.path.getmtime(index_path)
   199	        data_mtime = os.path.getmtime(jsonl_file_path)
   200	        if idx_mtime >= data_mtime:
   201	            try:
   202	                with open(index_path, 'rb') as f:
   203	                    index_dict = orjson.loads(f.read())
   204	            except (orjson.JSONDecodeError, OSError):
   205	                build_jsonl_index(jsonl_file_path)
   206	                with open(index_path, 'rb') as f:
   207	                    index_dict = orjson.loads(f.read())
   208	            return _verify_and_compact(jsonl_file_path, index_dict)
   209	
   210	    # Full path: mmap line-count scan
   211	    with open(jsonl_file_path, 'rb') as f:
   212	        with mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ) as mm:
   213	            non_blank_count = sum(
   214	                1 for line in iter(mm.readline, b'')
   215	                if line.strip()
   216	            )
   217	
   218	    with open(index_path, 'rb') as f:
   219	        index_dict = orjson.loads(f.read())
   220	
   221	    if non_blank_count != len(index_dict):
   222	        build_jsonl_index(jsonl_file_path)
   223	        with open(index_path, 'rb') as f:
   224	            index_dict = orjson.loads(f.read())
   225	
   226	    return _verify_and_compact(jsonl_file_path, index_dict)

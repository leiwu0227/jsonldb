   232	def _is_datetime_string(linekey: str, timespec: Optional[str] = None) -> bool:
   233	    """Check if a string represents a datetime in ISO format.
   234	
   235	    Args:
   236	        linekey: String to check
   237	        timespec: Datetime precision ('seconds' or 'microseconds').
   238	            Defaults to the module-level TIME_SPEC.
   239	
   240	    Returns:
   241	        bool: True if the string appears to be a datetime in ISO format
   242	    """
   243	    if (timespec or TIME_SPEC) == 'seconds':
   244	        return len(linekey) == 19 and 'T' in linekey and '-' in linekey and ':' in linekey
   245	    else:  # microseconds
   246	        return len(linekey) == 26 and 'T' in linekey and '-' in linekey and ':' in linekey
   247	
   248	def serialize_linekey(linekey: LineKey, timespec: Optional[str] = None) -> str:
   249	    """
   250	    Convert a linekey to its string representation.
   251	
   252	    Args:
   253	        linekey: String or datetime object to serialize
   254	        timespec: Datetime precision ('seconds' or 'microseconds').
   255	            Defaults to the module-level TIME_SPEC.
   256	
   257	    Returns:
   258	        String representation of the linekey
   259	    """
   260	    if isinstance(linekey, str):
   261	        return linekey
   262	    elif isinstance(linekey, dt.datetime):
   263	        return linekey.isoformat(timespec=timespec or TIME_SPEC)
   264	    return str(linekey)
   265	
   266	def deserialize_linekey(linekey_str: str, default_format: Optional[str] = None) -> LineKey:
   267	    """
   268	    Convert a string linekey back to its original type.
   269	    
   270	    Args:
   271	        linekey_str: String to deserialize
   272	        default_format: Format hint for deserialization ('datetime' supported)
   273	        
   274	    Returns:
   275	        Original type of the linekey (datetime or string)
   276	    """
   277	    if default_format == "datetime":
   278	        return dt.datetime.fromisoformat(linekey_str)
   279	    return linekey_str
   280	
   281	def detect_timespec(linekey: str) -> Optional[str]:
   282	    """Detect the datetime precision of a linekey string.
   283	
   284	    Example: detect_timespec("2024-01-01T12:00:00.123456") -> 'microseconds'
   285	             detect_timespec("2024-01-01T12:00:00") -> 'seconds'
   286	             detect_timespec("key1") -> None
   287	
   288	    Args:
   289	        linekey: String to classify
   290	
   291	    Returns:
   292	        'seconds' or 'microseconds' if the string is a parseable ISO datetime
   293	        of that precision, None otherwise
   294	    """
   295	    for spec in ('seconds', 'microseconds'):
   296	        if _is_datetime_string(linekey, spec):
   297	            try:
   298	                dt.datetime.fromisoformat(linekey)
   299	                return spec
   300	            except ValueError:
   301	                return None
   302	    return None

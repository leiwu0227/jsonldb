   113	def _verify_and_compact(jsonl_file_path: str, index_dict: dict) -> bool:
   114	    """Spot-check, sort-verify, and compact a JSONL file using a pre-loaded index.
   115	
   116	    Args:
   117	        jsonl_file_path: Path to the JSONL file
   118	        index_dict: Pre-loaded index dictionary (key -> byte offset)
   119	
   120	    Returns:
   121	        True if file exists and was processed, False if index is empty
   122	    """
   123	    if index_dict:
   124	        keys = list(index_dict.keys())
   125	        try:
   126	            with open(jsonl_file_path, 'rb', buffering=BUFFER_SIZE) as f:
   127	                for check_key in [keys[0], keys[-1]]:
   128	                    f.seek(index_dict[check_key])
   129	                    line = f.readline()
   130	                    data = orjson.loads(line)
   131	                    parsed_key = next(iter(data))
   132	                    if parsed_key != check_key:
   133	                        raise ValueError("key mismatch")
   134	        except (orjson.JSONDecodeError, ValueError, TypeError, OSError):
   135	            build_jsonl_index(jsonl_file_path)
   136	            with open(f"{jsonl_file_path}.idx", 'rb') as f2:
   137	                index_dict = orjson.loads(f2.read())
   138	
   139	    if not index_dict:
   140	        return True
   141	
   142	    keys = list(index_dict.keys())
   143	    is_sorted = all(keys[i] <= keys[i+1] for i in range(len(keys)-1))
   144	
   145	    if is_sorted:
   146	        if index_dict[keys[0]] == 0:
   147	            with open(jsonl_file_path, 'rb', buffering=BUFFER_SIZE) as f:
   148	                f.seek(index_dict[keys[-1]])
   149	                last_line = f.readline()
   150	                expected_end = index_dict[keys[-1]] + len(last_line)
   151	                actual_size = os.path.getsize(jsonl_file_path)
   152	                if expected_end == actual_size:
   153	                    return True
   154	
   155	    sorted_keys = sorted(keys, key=str)
   156	    tmp_path = jsonl_file_path + '.tmp'
   157	
   158	    with open(jsonl_file_path, 'rb', buffering=BUFFER_SIZE) as src:
   159	        with open(tmp_path, 'wb', buffering=BUFFER_SIZE) as dst:
   160	            for key in sorted_keys:
   161	                src.seek(index_dict[key])
   162	                line = src.readline()
   163	                dst.write(line)
   164	
   165	    os.replace(tmp_path, jsonl_file_path)
   166	    build_jsonl_index(jsonl_file_path)
   167	    return True

   421	def select_jsonl(jsonl_file_path: str, lower_key: Optional[LineKey] = None, upper_key: Optional[LineKey] = None, auto_deserialize: bool = True, timespec: Optional[str] = None) -> DataDict:
   422	    """
   423	    Select records from a JSONL file within a key range.
   424	    
   425	    Args:
   426	        jsonl_file_path: Path to the JSONL file
   427	        lower_key: Lower bound key (inclusive). If None, uses smallest key.
   428	        upper_key: Upper bound key (inclusive). If None, uses largest key.
   429	        auto_deserialize: Whether to auto-deserialize datetime keys
   430	        
   431	    Returns:
   432	        Dictionary of records within the range
   433	        
   434	    Raises:
   435	        FileNotFoundError: If file or index doesn't exist
   436	        OSError: If file operations fail
   437	    """
   438	    # If both keys are None, return all records
   439	    if lower_key is None and upper_key is None:
   440	        return load_jsonl(jsonl_file_path, auto_deserialize, timespec)
   441	
   442	    if lower_key == upper_key:
   443	        return select_line_jsonl(jsonl_file_path, lower_key, auto_deserialize, timespec)
   444	
   445	    ensure_index_exists(jsonl_file_path)
   446	
   447	    
   448	    try:
   449	        # Load index
   450	        with open(f"{jsonl_file_path}.idx", 'rb') as f:
   451	            index_dict = orjson.loads(f.read())
   452	
   453	        # If no keys in index, return empty dict
   454	        if not index_dict:
   455	            return {}
   456	            
   457	        # Get all keys from index
   458	        all_keys = list(index_dict.keys())
   459	        
   460	        # Set default values if None
   461	        if lower_key is None:
   462	            lower_key = all_keys[0]   # index keys are stored sorted
   463	        if upper_key is None:
   464	            upper_key = all_keys[-1]
   465	            
   466	        # Serialize the keys
   467	        lower_key = serialize_linekey(lower_key, timespec)
   468	        upper_key = serialize_linekey(upper_key, timespec)
   469	        
   470	        # Use bisect for O(log n) range selection
   471	        lo = bisect_left(all_keys, lower_key)
   472	        hi = bisect_right(all_keys, upper_key)
   473	        selected_linekeys = all_keys[lo:hi]
   474	
   475	        # Read in offset order for sequential I/O
   476	        offset_key_pairs = sorted(
   477	            [(index_dict[k], k) for k in selected_linekeys]
   478	        )
   479	        raw_results = {}
   480	        with open(jsonl_file_path, 'rb', buffering=BUFFER_SIZE) as f:
   481	            for offset, linekey in offset_key_pairs:
   482	                f.seek(offset)
   483	                line = f.readline()
   484	                data = orjson.loads(line)
   485	                raw_results[linekey] = data[linekey]
   486	
   487	        # Rebuild in sorted key order with deserialization
   488	        result_dict = {}
   489	        for linekey in selected_linekeys:
   490	            _store_with_key(result_dict, linekey, raw_results[linekey], auto_deserialize, timespec)
   491	        return result_dict
   492	        
   493	    except OSError as e:
   494	        raise OSError(f"Failed to select from JSONL file {jsonl_file_path}: {str(e)}")

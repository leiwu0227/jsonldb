   335	def save_jsonl(jsonl_file_path: str, db_dict: DataDict, timespec: Optional[str] = None) -> None:
   336	    """
   337	    Save a dictionary to a JSONL file with automatic indexing.
   338	    
   339	    Efficiently writes records and maintains an index of byte positions.
   340	    Handles empty dictionaries and ensures atomic writes.
   341	    
   342	    Args:
   343	        jsonl_file_path: Path to save the JSONL file
   344	        db_dict: Dictionary of records to save
   345	        
   346	    Raises:
   347	        OSError: If file operations fail
   348	    """
   349	    index: IndexDict = {}
   350	    
   351	    try:
   352	        # Handle empty dictionary case
   353	        if not db_dict:
   354	            with open(jsonl_file_path, 'wb') as f:
   355	                pass  # create empty file
   356	            with open(f"{jsonl_file_path}.idx", 'wb') as f:
   357	                f.write(orjson.dumps({}, option=orjson.OPT_SORT_KEYS))
   358	            return
   359	
   360	        # Stream lines to the file while tracking byte offsets
   361	        byte_offset = 0
   362	        with open(jsonl_file_path, 'wb', buffering=BUFFER_SIZE) as f:
   363	            for linekey, data in db_dict.items():
   364	                serialized_key = serialize_linekey(linekey, timespec)
   365	                line = _fast_dumps({serialized_key: data}).encode('utf-8')
   366	                f.write(line)
   367	                index[serialized_key] = byte_offset
   368	                byte_offset += len(line)
   369	
   370	        # Write index (OPT_SORT_KEYS sorts on dump)
   371	        with open(f"{jsonl_file_path}.idx", 'wb') as f:
   372	            f.write(orjson.dumps(index, option=orjson.OPT_SORT_KEYS))
   373	            
   374	    except OSError as e:
   375	        raise OSError(f"Failed to save JSONL file {jsonl_file_path}: {str(e)}")

   377	def load_jsonl(jsonl_file_path: str, auto_deserialize: bool = True, timespec: Optional[str] = None) -> DataDict:
   378	    """
   379	    Load a JSONL file into a dictionary.
   380	    
   381	    Reads each line as a JSON object and builds a dictionary.
   382	    Handles datetime deserialization and skips invalid lines.
   383	    
   384	    Args:
   385	        jsonl_file_path: Path to the JSONL file to load
   386	        auto_deserialize: Whether to convert datetime strings back to datetime objects
   387	        
   388	    Returns:
   389	        Dictionary of loaded records
   390	        
   391	    Raises:
   392	        FileNotFoundError: If the file doesn't exist
   393	        OSError: If file operations fail
   394	    """
   395	    if not os.path.exists(jsonl_file_path):
   396	        raise FileNotFoundError(f"JSONL file not found: {jsonl_file_path}")
   397	
   398	    result_dict: DataDict = {}
   399	    
   400	    try:
   401	        with open(jsonl_file_path, 'rb', buffering=BUFFER_SIZE) as f:
   402	            for line in f:
   403	                line = line.strip()
   404	                if not line:
   405	                    continue
   406	
   407	                try:
   408	                    data = orjson.loads(line)
   409	                    if isinstance(data, dict) and len(data) == 1:
   410	                        linekey = next(iter(data))
   411	                        _store_with_key(result_dict, linekey, data[linekey], auto_deserialize, timespec)
   412	                except (orjson.JSONDecodeError, ValueError):
   413	                    print("WARNING: invalid JSON line " + line.decode('utf-8', errors='replace'))
   414	                    continue  # Skip invalid JSON lines
   415	
   416	        return result_dict
   417	
   418	    except OSError as e:
   419	        raise OSError(f"Failed to load JSONL file {jsonl_file_path}: {str(e)}")

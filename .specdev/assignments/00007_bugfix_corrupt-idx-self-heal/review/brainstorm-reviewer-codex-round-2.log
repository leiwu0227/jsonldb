   558	    # =============== Metadata Management ===============
   559	    def _make_meta_entry(self, name: str, file_path: str, linted: bool = False,
   560	                         lint_time: str = "") -> Dict[str, Any]:
   561	        """Build one db.meta entry for a JSONL file from its index file.
   562	
   563	        Example: {"name": "users", "path": ".../users.jsonl", "min_index": "a",
   564	                  "max_index": "z", "size": 123, "count": 3, "lint_time": "", "linted": False}
   565	        """
   566	        index_file = file_path + '.idx'
   567	        min_index = max_index = None
   568	        count = 0
   569	        if os.path.exists(index_file):
   570	            with open(index_file, 'rb') as f:
   571	                index = orjson.loads(f.read())
   572	            if index:
   573	                keys = list(index.keys())
   574	                min_index, max_index = keys[0], keys[-1]
   575	                count = len(keys)
   576	        return {
   577	            "name": name,
   578	            "path": file_path,
   579	            "min_index": min_index,
   580	            "max_index": max_index,
   581	            "size": os.path.getsize(file_path),
   582	            "count": count,
   583	            "lint_time": lint_time,
   584	            "linted": linted,
   585	        }
   586	
   587	    def build_dbmeta(self) -> None:
   588	        """
   589	        Build or update the db.meta file with information about all JSONL files.
   590	        
   591	        The db.meta file contains metadata for each JSONL file including:
   592	        - name: filename without .jsonl extension
   593	        - min_index: smallest index from the index file
   594	        - max_index: biggest index from the index file
   595	        - size: size of the file in bytes
   596	        - lint_time: ISO format timestamp of last lint
   597	        - linted: boolean indicating if file has been linted
   598	        """
   599	        # Get all JSONL files
   600	        jsonl_files = self.get_file_list()
   601	        
   602	        if not jsonl_files:
   603	            # If no JSONL files are found, create an empty db.meta file
   604	            with open(self.dbmeta_path, 'w', encoding='utf-8') as f:
   605	                f.write('\n')
   606	            return
   607	            
   608	        # Initialize metadata dictionary
   609	        metadata = {}
   610	        
   611	        # Process each JSONL file
   612	        for name in jsonl_files:
   613	            file_path = self._get_file_path(name)
   614	
   615	            # Build index if it doesn't exist
   616	            if not os.path.exists(file_path + '.idx'):
   617	                build_jsonl_index(file_path)
   618	
   619	            metadata[name] = self._make_meta_entry(name, file_path)
   620	        
   621	        # Save metadata using jsonlfile
   622	        save_jsonl(self.dbmeta_path, metadata)
   623	
   624	    def get_dbmeta(self) -> Dict[str, Any]:
   625	        """
   626	        Get the database metadata as a dictionary.
   627	        
   628	        Returns:
   629	            Dictionary containing metadata for all JSONL files in the database
   630	        """
   631	        if not os.path.exists(self.dbmeta_path):
   632	            self.build_dbmeta()
   633	        return load_jsonl(self.dbmeta_path)
   634	    
   635	    def delete_dbmeta(self,name: str) -> None:
   636	        """
   637	        Delete the metadata for a specific JSONL file in db.meta.
   638	        """
   639	        if not os.path.exists(self.dbmeta_path):
   640	            self.build_dbmeta()
   641	        delete_jsonl(self.dbmeta_path, [name])
   642	    
   643	    def update_dbmeta(self, name: str, linted: bool = False) -> None:
   644	        """
   645	        Update the metadata for a specific JSONL file in db.meta.
   646	        
   647	        Args:
   648	            name: Name of the JSONL file (with or without .jsonl extension)
   649	            linted: Value to set for the linted field
   650	        """
   651	        # Metadata key is the name without the .jsonl extension
   652	        meta_key = name[:-6] if name.endswith('.jsonl') else name
   653	
   654	        # Use hierarchical path for the data file
   655	        file_path = self._get_file_path(name)
   656	        lint_time = datetime.now().isoformat() if linted else ""
   657	        entry = self._make_meta_entry(meta_key, file_path, linted, lint_time)
   658	
   659	        # Update metadata file using jsonlfile
   660	        update_jsonl(self.dbmeta_path, {meta_key: entry})


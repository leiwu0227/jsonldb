   304	def _store_with_key(result_dict: DataDict, linekey: str, value: dict,
   305	                    auto_deserialize: bool, timespec: Optional[str] = None) -> None:
   306	    """Store value under linekey, converting datetime-looking keys when requested.
   307	
   308	    Example: _store_with_key(d, "2024-01-01T00:00:00", {"v": 1}, True)
   309	    stores under datetime(2024, 1, 1); non-datetime keys stay strings.
   310	    """
   311	    if auto_deserialize and _is_datetime_string(linekey, timespec):
   312	        try:
   313	            result_dict[deserialize_linekey(linekey, "datetime")] = value
   314	            return
   315	        except ValueError:
   316	            pass
   317	    result_dict[linekey] = value

   496	def select_line_jsonl(jsonl_file_path: str, linekey: LineKey, auto_serialize: bool = True, timespec: Optional[str] = None) -> DataDict:
   497	    """
   498	    Get a single record from a JSONL file based on the linekey.
   499	
   500	    Args:

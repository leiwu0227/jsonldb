   544	def update_jsonl(jsonl_file_path: str, update_dict: DataDict, timespec: Optional[str] = None) -> None:
   545	    """
   546	    Update or insert records in a JSONL file.
   547	    
   548	    Efficiently handles both updates and inserts:
   549	    - Updates in place if new record fits in old space
   550	    - Appends to file if record grows
   551	    - Maintains index automatically
   552	    
   553	    Args:
   554	        jsonl_file_path: Path to the JSONL file
   555	        update_dict: Dictionary of records to update/insert
   556	        
   557	    Raises:
   558	        OSError: If file operations fail
   559	    """
   560	    ensure_index_exists(jsonl_file_path)
   561	    
   562	    try:
   563	        # Load index
   564	        with open(f"{jsonl_file_path}.idx", 'rb') as f:
   565	            index = orjson.loads(f.read())
   566	
   567	        updates = []
   568	        appends = []
   569	        
   570	        # Process records
   571	        with open(jsonl_file_path, 'rb+', buffering=BUFFER_SIZE) as f:
   572	            f.seek(0, os.SEEK_END)
   573	            # Heal a missing trailing newline so appends start on a fresh line
   574	            if f.tell() > 0:
   575	                f.seek(-1, os.SEEK_END)
   576	                if f.read(1) != b'\n':
   577	                    f.write(b'\n')
   578	            append_pos = f.tell()
   579	
   580	            for linekey, data in update_dict.items():
   581	                linekey = serialize_linekey(linekey, timespec)
   582	                new_line = _fast_dumps({linekey: data}).encode('utf-8')
   583	
   584	                if linekey in index:
   585	                    f.seek(index[linekey])
   586	                    old_line = f.readline()
   587	                    
   588	                    if len(new_line) <= len(old_line):
   589	                        updates.append((index[linekey], new_line, len(old_line)))
   590	                    else:
   591	                        updates.append((index[linekey], b' ' * (len(old_line) - 1) + b'\n', len(old_line)))
   592	                        appends.append((linekey, new_line))
   593	                else:
   594	                    appends.append((linekey, new_line))
   595	
   596	            # Apply updates
   597	            for pos, line, old_len in updates:
   598	                if len(line) < old_len:
   599	                    # Pad before the newline so the record keeps its exact old
   600	                    # length and the line stays newline-terminated
   601	                    line = line[:-1] + b' ' * (old_len - len(line)) + b'\n'
   602	                f.seek(pos)
   603	                f.write(line)
   604	
   605	            # Apply appends
   606	            if appends:
   607	                f.seek(append_pos)
   608	                for linekey, line in appends:
   609	                    index[linekey] = f.tell()
   610	                    f.write(line)
   611	
   612	        # Update index
   613	        with open(f"{jsonl_file_path}.idx", 'wb') as f:
   614	            f.write(orjson.dumps(index, option=orjson.OPT_SORT_KEYS))
   615	            
   616	    except OSError as e:
   617	        raise OSError(f"Failed to update JSONL file {jsonl_file_path}: {str(e)}")
   618	
   619	def delete_jsonl(jsonl_file_path: str, linekeys: List[LineKey], timespec: Optional[str] = None) -> None:
   620	    """
   621	    Delete records from a JSONL file.
   622	    
   623	    Marks deleted lines with spaces and updates the index.
   624	    Maintains file size but removes entries from index.
   625	    
   626	    Args:
   627	        jsonl_file_path: Path to the JSONL file
   628	        linekeys: List of keys to delete
   629	        
   630	    Raises:
   631	        OSError: If file operations fail
   632	    """
   633	    ensure_index_exists(jsonl_file_path)
   634	    
   635	    try:
   636	        # Load index using orjson for faster JSON parsing
   637	        with open(f"{jsonl_file_path}.idx", 'rb') as f:
   638	            index = orjson.loads(f.read())
   639	
   640	        # Process deletions
   641	        linekeys = [serialize_linekey(key, timespec) for key in linekeys]
   642	        
   643	        # Use regular file operations like update_jsonl
   644	        with open(jsonl_file_path, 'rb+', buffering=BUFFER_SIZE) as f:
   645	            for linekey in linekeys:
   646	                if linekey in index:
   647	                    f.seek(index[linekey])
   648	                    line = f.readline()
   649	                    if not line.endswith(b'\n'):
   650	                        line += b'\n'
   651	                    
   652	                    f.seek(index[linekey])
   653	                    f.write(b' ' * (len(line) - 1) + b'\n')
   654	                    del index[linekey]
   655	
   656	        # Update index using orjson for faster JSON serialization
   657	        with open(f"{jsonl_file_path}.idx", 'wb') as f:
   658	            f.write(orjson.dumps(index, option=orjson.OPT_SORT_KEYS))
   659	            
   660	    except OSError as e:
   661	        raise OSError(f"Failed to delete from JSONL file {jsonl_file_path}: {str(e)}")

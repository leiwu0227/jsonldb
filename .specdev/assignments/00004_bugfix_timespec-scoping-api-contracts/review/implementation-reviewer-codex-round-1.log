   573	def update_jsonl(jsonl_file_path: str, update_dict: DataDict, timespec: Optional[str] = None) -> None:
   574	    """
   575	    Update or insert records in a JSONL file.
   576	    
   577	    Efficiently handles both updates and inserts:
   578	    - Updates in place if new record fits in old space
   579	    - Appends to file if record grows
   580	    - Maintains index automatically
   581	    
   582	    Args:
   583	        jsonl_file_path: Path to the JSONL file
   584	        update_dict: Dictionary of records to update/insert
   585	        
   586	    Raises:
   587	        OSError: If file operations fail
   588	    """
   589	    ensure_index_exists(jsonl_file_path)
   590	    
   591	    try:
   592	        # Load index
   593	        with open(f"{jsonl_file_path}.idx", 'rb') as f:
   594	            index = orjson.loads(f.read())
   595	
   596	        updates = []
   597	        appends = []
   598	        
   599	        # Process records
   600	        with open(jsonl_file_path, 'rb+', buffering=BUFFER_SIZE) as f:
   601	            f.seek(0, os.SEEK_END)
   602	            # Heal a missing trailing newline so appends start on a fresh line
   603	            if f.tell() > 0:
   604	                f.seek(-1, os.SEEK_END)
   605	                if f.read(1) != b'\n':
   606	                    f.write(b'\n')
   607	            append_pos = f.tell()
   608	
   609	            for linekey, data in update_dict.items():
   610	                linekey = serialize_linekey(linekey, timespec)
   611	                new_line = _fast_dumps({linekey: data}).encode('utf-8')
   612	
   613	                if linekey in index:
   614	                    f.seek(index[linekey])
   615	                    old_line = f.readline()
   616	                    
   617	                    if len(new_line) <= len(old_line):
   618	                        updates.append((index[linekey], new_line, len(old_line)))
   619	                    else:
   620	                        updates.append((index[linekey], b' ' * (len(old_line) - 1) + b'\n', len(old_line)))
   621	                        appends.append((linekey, new_line))
   622	                else:
   623	                    appends.append((linekey, new_line))
   624	
   625	            # Apply updates
   626	            for pos, line, old_len in updates:
   627	                if len(line) < old_len:
   628	                    # Pad before the newline so the record keeps its exact old
   629	                    # length and the line stays newline-terminated
   630	                    line = line[:-1] + b' ' * (old_len - len(line)) + b'\n'
   631	                f.seek(pos)
   632	                f.write(line)
   633	
   634	            # Apply appends
   635	            if appends:
   636	                f.seek(append_pos)
   637	                for linekey, line in appends:
   638	                    index[linekey] = f.tell()
   639	                    f.write(line)
   640	
   641	        # Update index
   642	        with open(f"{jsonl_file_path}.idx", 'wb') as f:
   643	            f.write(orjson.dumps(dict(sorted(index.items())), option=orjson.OPT_SORT_KEYS))
   644	            
   645	    except OSError as e:
   646	        raise OSError(f"Failed to update JSONL file {jsonl_file_path}: {str(e)}")
   647	
   648	def delete_jsonl(jsonl_file_path: str, linekeys: List[LineKey], timespec: Optional[str] = None) -> None:
   649	    """
   650	    Delete records from a JSONL file.
   651	    
   652	    Marks deleted lines with spaces and updates the index.
   653	    Maintains file size but removes entries from index.
   654	    
   655	    Args:
   656	        jsonl_file_path: Path to the JSONL file
   657	        linekeys: List of keys to delete
   658	        
   659	    Raises:
   660	        OSError: If file operations fail
   661	    """
   662	    ensure_index_exists(jsonl_file_path)
   663	    
   664	    try:
   665	        # Load index using orjson for faster JSON parsing
   666	        with open(f"{jsonl_file_path}.idx", 'rb') as f:
   667	            index = orjson.loads(f.read())
   668	
   669	        # Process deletions
   670	        linekeys = [serialize_linekey(key, timespec) for key in linekeys]
   671	        
   672	        # Use regular file operations like update_jsonl
   673	        with open(jsonl_file_path, 'rb+', buffering=BUFFER_SIZE) as f:
   674	            for linekey in linekeys:
   675	                if linekey in index:
   676	                    f.seek(index[linekey])
   677	                    line = f.readline()
   678	                    if not line.endswith(b'\n'):
   679	                        line += b'\n'
   680	                    
   681	                    # Mark as deleted using _fast_dumps for consistency
   682	                    deleted_line = _fast_dumps({linekey: {}}).encode('utf-8')
   683	                    f.seek(index[linekey])
   684	                    f.write(b' ' * (len(line) - 1) + b'\n')
   685	                    del index[linekey]
   686	
   687	        # Update index using orjson for faster JSON serialization
   688	        with open(f"{jsonl_file_path}.idx", 'wb') as f:
   689	            f.write(orjson.dumps(dict(sorted(index.items())), option=orjson.OPT_SORT_KEYS))
   690	            
   691	    except OSError as e:
   692	        raise OSError(f"Failed to delete from JSONL file {jsonl_file_path}: {str(e)}")

   357	def save_jsonl(jsonl_file_path: str, db_dict: DataDict, timespec: Optional[str] = None) -> None:
   358	    """
   359	    Save a dictionary to a JSONL file with automatic indexing.
   360	    
   361	    Efficiently writes records and maintains an index of byte positions.
   362	    Handles empty dictionaries and ensures atomic writes.
   363	    
   364	    Args:
   365	        jsonl_file_path: Path to save the JSONL file
   366	        db_dict: Dictionary of records to save
   367	        
   368	    Raises:
   369	        OSError: If file operations fail
   370	    """
   371	    index: IndexDict = {}
   372	    
   373	    try:
   374	        # Handle empty dictionary case
   375	        if not db_dict:
   376	            with open(jsonl_file_path, 'wb') as f:
   377	                pass  # create empty file
   378	            with open(f"{jsonl_file_path}.idx", 'wb') as f:
   379	                f.write(orjson.dumps({}, option=orjson.OPT_SORT_KEYS))
   380	            return
   381	
   382	        byte_offset = 0
   383	        lines = []
   384	        
   385	        # Pre-process all lines
   386	        for linekey, data in db_dict.items():
   387	            serialized_key = serialize_linekey(linekey, timespec)
   388	            line_dict = {serialized_key: data}
   389	            line = _fast_dumps(line_dict).encode('utf-8')
   390	            lines.append(line)
   391	            index[serialized_key] = byte_offset
   392	            byte_offset += len(line)
   393	
   394	        # Write all lines at once
   395	        with open(jsonl_file_path, 'wb', buffering=BUFFER_SIZE) as f:
   396	            for line in lines:
   397	                f.write(line)
   398	
   399	        # Write index atomically
   400	        with open(f"{jsonl_file_path}.idx", 'wb') as f:
   401	            f.write(orjson.dumps(dict(sorted(index.items())), option=orjson.OPT_SORT_KEYS))
   402	            
   403	    except OSError as e:
   404	        raise OSError(f"Failed to save JSONL file {jsonl_file_path}: {str(e)}")

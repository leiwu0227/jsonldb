   406	def load_jsonl(jsonl_file_path: str, auto_deserialize: bool = True, timespec: Optional[str] = None) -> DataDict:
   407	    """
   408	    Load a JSONL file into a dictionary.
   409	    
   410	    Reads each line as a JSON object and builds a dictionary.
   411	    Handles datetime deserialization and skips invalid lines.
   412	    
   413	    Args:
   414	        jsonl_file_path: Path to the JSONL file to load
   415	        auto_deserialize: Whether to convert datetime strings back to datetime objects
   416	        
   417	    Returns:
   418	        Dictionary of loaded records
   419	        
   420	    Raises:
   421	        FileNotFoundError: If the file doesn't exist
   422	        OSError: If file operations fail
   423	    """
   424	    if not os.path.exists(jsonl_file_path):
   425	        raise FileNotFoundError(f"JSONL file not found: {jsonl_file_path}")
   426	
   427	    result_dict: DataDict = {}
   428	    
   429	    try:
   430	        with open(jsonl_file_path, 'rb', buffering=BUFFER_SIZE) as f:
   431	            for line in f:
   432	                line = line.strip()
   433	                if not line:
   434	                    continue
   435	
   436	                try:
   437	                    data = orjson.loads(line)
   438	                    if isinstance(data, dict) and len(data) == 1:
   439	                        linekey = next(iter(data))
   440	                        _store_with_key(result_dict, linekey, data[linekey], auto_deserialize, timespec)
   441	                except (orjson.JSONDecodeError, ValueError):
   442	                    print("WARNING: invalid JSON line " + line.decode('utf-8', errors='replace'))
   443	                    continue  # Skip invalid JSON lines
   444	
   445	        return result_dict
   446	
   447	    except OSError as e:
   448	        raise OSError(f"Failed to load JSONL file {jsonl_file_path}: {str(e)}")

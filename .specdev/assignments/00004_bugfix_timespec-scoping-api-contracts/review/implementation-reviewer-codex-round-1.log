   450	def select_jsonl(jsonl_file_path: str, lower_key: Optional[LineKey] = None, upper_key: Optional[LineKey] = None, auto_deserialize: bool = True, timespec: Optional[str] = None) -> DataDict:
   451	    """
   452	    Select records from a JSONL file within a key range.
   453	    
   454	    Args:
   455	        jsonl_file_path: Path to the JSONL file
   456	        lower_key: Lower bound key (inclusive). If None, uses smallest key.
   457	        upper_key: Upper bound key (inclusive). If None, uses largest key.
   458	        auto_deserialize: Whether to auto-deserialize datetime keys
   459	        
   460	    Returns:
   461	        Dictionary of records within the range
   462	        
   463	    Raises:
   464	        FileNotFoundError: If file or index doesn't exist
   465	        OSError: If file operations fail
   466	    """
   467	    # If both keys are None, return all records
   468	    if lower_key is None and upper_key is None:
   469	        return load_jsonl(jsonl_file_path, auto_deserialize, timespec)
   470	
   471	    if lower_key == upper_key:
   472	        return select_line_jsonl(jsonl_file_path, lower_key, auto_deserialize, timespec)
   473	
   474	    ensure_index_exists(jsonl_file_path)
   475	
   476	    
   477	    try:
   478	        # Load index
   479	        with open(f"{jsonl_file_path}.idx", 'rb') as f:
   480	            index_dict = orjson.loads(f.read())
   481	
   482	        # If no keys in index, return empty dict
   483	        if not index_dict:
   484	            return {}
   485	            
   486	        # Get all keys from index
   487	        all_keys = list(index_dict.keys())
   488	        
   489	        # Set default values if None
   490	        if lower_key is None:
   491	            lower_key = min(all_keys)
   492	        if upper_key is None:
   493	            upper_key = max(all_keys)
   494	            
   495	        # Serialize the keys
   496	        lower_key = serialize_linekey(lower_key, timespec)
   497	        upper_key = serialize_linekey(upper_key, timespec)
   498	        
   499	        # Use bisect for O(log n) range selection
   500	        lo = bisect_left(all_keys, lower_key)
   501	        hi = bisect_right(all_keys, upper_key)
   502	        selected_linekeys = all_keys[lo:hi]
   503	
   504	        # Read in offset order for sequential I/O
   505	        offset_key_pairs = sorted(
   506	            [(index_dict[k], k) for k in selected_linekeys]
   507	        )
   508	        raw_results = {}
   509	        with open(jsonl_file_path, 'rb', buffering=BUFFER_SIZE) as f:
   510	            for offset, linekey in offset_key_pairs:
   511	                f.seek(offset)
   512	                line = f.readline()
   513	                data = orjson.loads(line)
   514	                raw_results[linekey] = data[linekey]
   515	
   516	        # Rebuild in sorted key order with deserialization
   517	        result_dict = {}
   518	        for linekey in selected_linekeys:
   519	            _store_with_key(result_dict, linekey, raw_results[linekey], auto_deserialize, timespec)
   520	        return result_dict
   521	        
   522	    except OSError as e:
   523	        raise OSError(f"Failed to select from JSONL file {jsonl_file_path}: {str(e)}")

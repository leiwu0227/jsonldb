   525	def select_line_jsonl(jsonl_file_path: str, linekey: LineKey, auto_serialize: bool = True, timespec: Optional[str] = None) -> DataDict:
   526	    """
   527	    Get a single record from a JSONL file based on the linekey.
   528	
   529	    Args:
   530	        jsonl_file_path: Path to the JSONL file
   531	        linekey: The key to look for
   532	        auto_serialize: Whether to serialize the lookup key and deserialize
   533	            datetime-looking keys in the result
   534	        timespec: Datetime precision ('seconds' or 'microseconds').
   535	            Defaults to the module-level TIME_SPEC.
   536	
   537	    Returns:
   538	        Single-record dict {linekey: value} if found, {} otherwise.
   539	        Example: {"key1": {"v": 1}}
   540	    """
   541	    # Serialize the key if needed
   542	    if auto_serialize:
   543	        linekey = serialize_linekey(linekey, timespec)
   544	    
   545	    ensure_index_exists(jsonl_file_path)
   546	    
   547	    index_path = jsonl_file_path + '.idx'
   548	    # Read the index file
   549	    with open(index_path, 'rb') as f:
   550	        index_dict = orjson.loads(f.read())
   551	    
   552	    # Check if key exists in index
   553	    if linekey not in index_dict:
   554	        return {}
   555	    
   556	    result_dict: DataDict = {}
   557	        
   558	
   559	    # Load selected records
   560	    with open(jsonl_file_path, 'rb', buffering=BUFFER_SIZE) as f:
   561	        try:
   562	            f.seek(index_dict[linekey])
   563	            line = f.readline().strip()
   564	            data = orjson.loads(line)
   565	            _store_with_key(result_dict, linekey, data[linekey], auto_serialize, timespec)
   566	        except (orjson.JSONDecodeError, ValueError, KeyError):
   567	            return {}
   568	
   569	    return result_dict

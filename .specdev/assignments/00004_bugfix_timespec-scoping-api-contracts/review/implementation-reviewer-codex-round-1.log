   454	    def delete_file_range(self, name: str, lower_key: Any, upper_key: Any) -> None:
   455	        """
   456	        Delete all keys within a range from a JSONL file.
   457	
   458	        Args:
   459	            name: Name of the JSONL file
   460	            lower_key: Lower bound of the key range
   461	            upper_key: Upper bound of the key range
   462	        """
   463	        file_path = self._get_file_path(name)
   464	        if not os.path.exists(file_path):
   465	            return
   466	            
   467	        # Get all keys from the index
   468	        index_path = file_path + '.idx'
   469	        if not os.path.exists(index_path):
   470	            build_jsonl_index(file_path)
   471	            
   472	        # Read the index file
   473	        with open(index_path, 'rb') as f:
   474	            index = orjson.loads(f.read())
   475	            
   476	        # Filter keys within range (bounds must use the same serialization as
   477	        # stored keys — str(datetime) uses a space, isoformat uses 'T')
   478	        lower_str = serialize_linekey(lower_key, self.timespec)
   479	        upper_str = serialize_linekey(upper_key, self.timespec)
   480	        keys_to_delete = [
   481	            key for key in index.keys()
   482	            if lower_str <= key <= upper_str
   483	        ]
   484	        
   485	        if keys_to_delete:
   486	            delete_jsonl(file_path, keys_to_delete)

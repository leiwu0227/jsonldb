   500	    # =============== Metadata Management ===============
   501	    def build_dbmeta(self) -> None:
   502	        """
   503	        Build or update the db.meta file with information about all JSONL files.
   504	        
   505	        The db.meta file contains metadata for each JSONL file including:
   506	        - name: filename without .jsonl extension
   507	        - min_index: smallest index from the index file
   508	        - max_index: biggest index from the index file
   509	        - size: size of the file in bytes
   510	        - lint_time: ISO format timestamp of last lint
   511	        - linted: boolean indicating if file has been linted
   512	        """
   513	        # Get all JSONL files
   514	        jsonl_files = self.get_file_list()
   515	        
   516	        if not jsonl_files:
   517	            # If no JSONL files are found, create an empty db.meta file
   518	            with open(self.dbmeta_path, 'w', encoding='utf-8') as f:
   519	                f.write('\n')
   520	            return
   521	            
   522	        # Initialize metadata dictionary
   523	        metadata = {}
   524	        
   525	        # Process each JSONL file
   526	        for name in jsonl_files:
   527	            # print(name)
   528	            file_path = self._get_file_path(name)
   529	            index_file = file_path + '.idx'
   530	            
   531	            # Build index if it doesn't exist
   532	            if not os.path.exists(index_file):
   533	                build_jsonl_index(file_path)
   534	            
   535	            # Get index range from index file
   536	            min_index = None
   537	            max_index = None
   538	            count = 0
   539	            
   540	            if os.path.exists(index_file):
   541	                with open(index_file, 'rb') as f:
   542	                    index = orjson.loads(f.read())
   543	                    if index:
   544	                        keys = list(index.keys())
   545	                        if keys:
   546	                            min_index = keys[0]
   547	                            max_index = keys[-1]
   548	                            count = len(keys)
   549	
   550	            file_path = self._get_file_path(name)
   551	            # Create metadata entry using name without extension as key
   552	            metadata[name] = {
   553	                "name": name,
   554	                "path": file_path,
   555	                "min_index": min_index,
   556	                "max_index": max_index,
   557	                "size": os.path.getsize(file_path),
   558	                "count": count,
   559	                "lint_time": "",
   560	                "linted": False,  # Default to False
   561	            }
   562	        
   563	        # Save metadata using jsonlfile
   564	        save_jsonl(self.dbmeta_path, metadata)

   247	    def search_file_list(self, regex: str) -> List[str]:
   248	        """
   249	        Search for file names that match a regular expression pattern.
   250	        
   251	        Args:
   252	            regex: Regular expression pattern to match against file names
   253	            
   254	        Returns:
   255	            List of file names that match the regex pattern

    assert "key2" not in loaded_data
    assert len(loaded_data) == 2
    assert loaded_data["key1"] == sample_data["key1"]
    assert loaded_data["key3"] == sample_data["key3"]

def test_delete_multiple_records(test_file, sample_data):

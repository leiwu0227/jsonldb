   899	    def revert(self, version_hash: str) -> None:
   900	        """
   901	        Revert the database to a previous version.
   902	        
   903	        Args:
   904	            version_hash: Hash of the commit to revert to
   905	            
   906	        Raises:
   907	            git.exc.GitCommandError: If git commands fail
   908	            ValueError: If the specified commit is not found
   909	        """
   910	        vercontrol_revert(self.folder_path, version_hash)
   911	        print(f"Successfully reverted the folder: {self.folder_path} to version: {version_hash}")
   912	    
   913	    def version(self) -> Dict[str, str]:
   914	        """
   915	        List all versions of the database.

   569	def test_lint_db_batches_meta_writes(db_folder, sample_data):
   570	    """Test that lint_db writes db.meta only once at the end, not per file"""
   571	    df, data_dict = sample_data
   572	    db = FolderDB(db_folder)
   573	    db.upsert_df("users", df)
   574	    db.upsert_dict("products", data_dict)
   575	
   576	    # Track calls to update_dbmeta
   577	    call_count = 0
   578	    original_update = db.update_dbmeta
   579	    def counting_update(*args, **kwargs):
   580	        nonlocal call_count
   581	        call_count += 1
   582	        return original_update(*args, **kwargs)
   583	    db.update_dbmeta = counting_update
   584	
   585	    db.lint_db()
   586	
   587	    # Should NOT call update_dbmeta per file anymore
   588	    assert call_count == 0
   589	
   590	    # But metadata should still be correct
   591	    metadata = select_jsonl(os.path.join(db_folder, "db.meta"))
   592	    assert metadata["users"]["linted"] is True
   593	    assert metadata["products"]["linted"] is True

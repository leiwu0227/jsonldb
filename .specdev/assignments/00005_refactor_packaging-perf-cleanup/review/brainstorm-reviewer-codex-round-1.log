   249	def serialize_linekey(linekey: LineKey, timespec: Optional[str] = None) -> str:
   250	    """
   251	    Convert a linekey to its string representation.
   252	
   253	    Args:
   254	        linekey: String or datetime object to serialize
   255	        timespec: Datetime precision ('seconds' or 'microseconds').
   256	            Defaults to the module-level TIME_SPEC.
   257	
   258	    Returns:
   259	        String representation of the linekey
   260	    """
   261	    if isinstance(linekey, str):
   262	        return linekey
   263	    elif isinstance(linekey, dt.datetime):
   264	        return linekey.isoformat(timespec=timespec or TIME_SPEC)

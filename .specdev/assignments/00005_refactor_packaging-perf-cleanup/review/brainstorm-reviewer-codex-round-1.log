   107	def test_update_shrink_keeps_line_terminator(test_file):
   108	    """Shrinking a record in place must keep every line newline-terminated"""
   109	    save_jsonl(test_file, {"a": {"v": "xxxxxxxxxxxxxxxxxxxx"}, "b": {"v": 2}})
   110	
   111	    update_jsonl(test_file, {"a": {"v": 1}})  # much shorter record
   112	
   113	    with open(test_file, 'rb') as f:
   114	        raw = f.read()
   115	    # Every line (including the padded one) must end with a newline, so the
   116	    # padding must not merge into record b's line.
   117	    lines = raw.split(b'\n')
   118	    assert lines[-1] == b''  # file ends with newline
   119	    record_lines = [l for l in lines[:-1] if l.strip()]
   120	    assert record_lines[0].rstrip(b' ') == b'{"a":{"v":1}}'  # padding stays on its own line
   121	    assert record_lines[1] == b'{"b":{"v":2}}'
   122	
   123	    # Rebuilt index must point at real record starts (not padding)
   124	    build_jsonl_index(test_file)
   125	    with open(test_file + '.idx', 'rb') as f:
   126	        index = json.loads(f.read())
   127	    for key, offset in index.items():
   128	        assert raw[offset:offset + 1] == b'{'
   129	
   130	    assert load_jsonl(test_file) == {"a": {"v": 1}, "b": {"v": 2}}

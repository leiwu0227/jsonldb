   233	def _is_datetime_string(linekey: str, timespec: Optional[str] = None) -> bool:
   234	    """Check if a string represents a datetime in ISO format.
   235	
   236	    Args:
   237	        linekey: String to check
   238	        timespec: Datetime precision ('seconds' or 'microseconds').
   239	            Defaults to the module-level TIME_SPEC.
   240	
   241	    Returns:
   242	        bool: True if the string appears to be a datetime in ISO format
   243	    """
   244	    if (timespec or TIME_SPEC) == 'seconds':
   245	        return len(linekey) == 19 and 'T' in linekey and '-' in linekey and ':' in linekey
   246	    else:  # microseconds
   247	        return len(linekey) == 26 and 'T' in linekey and '-' in linekey and ':' in linekey

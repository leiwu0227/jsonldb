   542	    if auto_serialize:
   543	        linekey = serialize_linekey(linekey, timespec)
   544	    
   545	    ensure_index_exists(jsonl_file_path)
   546	    
   547	    index_path = jsonl_file_path + '.idx'
   548	    # Read the index file
   549	    with open(index_path, 'rb') as f:
   550	        index_dict = orjson.loads(f.read())
   551	    
   552	    # Check if key exists in index
   553	    if linekey not in index_dict:
   554	        return {}
   555	    
   556	    result_dict: DataDict = {}
   557	        
   558	
   559	    # Load selected records
   560	    with open(jsonl_file_path, 'rb', buffering=BUFFER_SIZE) as f:
   561	        try:
   562	            f.seek(index_dict[linekey])
   563	            line = f.readline().strip()
   564	            data = orjson.loads(line)
   565	            _store_with_key(result_dict, linekey, data[linekey], auto_serialize, timespec)
   566	        except (orjson.JSONDecodeError, ValueError, KeyError):
   567	            return {}
   568	
   569	    return result_dict

   170	def lint_jsonl(jsonl_file_path: str, force: bool = False) -> bool:
   171	    """Clean and optimize a JSONL file.
   172	
   173	    Uses stream-based approach to avoid loading entire file into memory.
   174	    Skips rewrite if file is already sorted and compact.
   175	
   176	    When force=False (default), skips the expensive mmap line-count scan
   177	    if the index file is at least as recent as the data file.
   178	
   179	    Args:
   180	        jsonl_file_path: Path to the JSONL file to optimize
   181	        force: If True, always run full mmap line-count verification
   182	
   183	    Returns:
   184	        bool: True if file exists (whether skipped or linted), False if not found
   185	    """
   186	    if not os.path.exists(jsonl_file_path):
   187	        return False
   188	
   189	    if os.path.getsize(jsonl_file_path) == 0:
   190	        ensure_index_exists(jsonl_file_path)
   191	        return True
   192	
   193	    ensure_index_exists(jsonl_file_path)
   194	
   195	    index_path = jsonl_file_path + ".idx"
   196	
   197	    # Fast path: skip mmap scan when index is fresh
   198	    if not force:
   199	        idx_mtime = os.path.getmtime(index_path)
   200	        data_mtime = os.path.getmtime(jsonl_file_path)
   201	        if idx_mtime >= data_mtime:
   202	            try:
   203	                with open(index_path, 'rb') as f:
   204	                    index_dict = orjson.loads(f.read())
   205	            except (orjson.JSONDecodeError, OSError):
   206	                build_jsonl_index(jsonl_file_path)
   207	                with open(index_path, 'rb') as f:
   208	                    index_dict = orjson.loads(f.read())
   209	            return _verify_and_compact(jsonl_file_path, index_dict)
   210	
   211	    # Full path: mmap line-count scan
   212	    with open(jsonl_file_path, 'rb') as f:
   213	        with mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ) as mm:
   214	            non_blank_count = sum(
   215	                1 for line in iter(mm.readline, b'')
   216	                if line.strip()
   217	            )
   218	
   219	    with open(index_path, 'rb') as f:
   220	        index_dict = orjson.loads(f.read())
   221	
   222	    if non_blank_count != len(index_dict):
   223	        build_jsonl_index(jsonl_file_path)
   224	        with open(index_path, 'rb') as f:
   225	            index_dict = orjson.loads(f.read())
   226	
   227	    return _verify_and_compact(jsonl_file_path, index_dict)

    30	def build_jsonl_index(jsonl_file_path: str) -> None:
    31	    """
    32	    Build an index file mapping linekeys to byte locations.
    33	    
    34	    Creates a .idx file containing a JSON object mapping each linekey
    35	    to its byte offset in the JSONL file. The index is sorted by linekey.
    36	    
    37	    Args:
    38	        jsonl_file_path: Path to the JSONL file to index
    39	        
    40	    Raises:
    41	        FileNotFoundError: If the JSONL file doesn't exist
    42	        OSError: If there are permission issues
    43	    """
    44	    index_file_path = f"{jsonl_file_path}.idx"
    45	    index_dict: IndexDict = {}
    46	
    47	    if not os.path.exists(jsonl_file_path):
    48	        raise FileNotFoundError(f"JSONL file not found: {jsonl_file_path}")
    49	
    50	    # Handle empty file case
    51	    if os.path.getsize(jsonl_file_path) == 0:
    52	        with open(index_file_path, 'wb') as f:
    53	            f.write(orjson.dumps(index_dict, option=orjson.OPT_SORT_KEYS))
    54	        return
    55	
    56	    try:
    57	        with open(jsonl_file_path, 'rb', buffering=BUFFER_SIZE) as f:
    58	            with mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ) as mm:
    59	                current_pos = 0
    60	                while True:
    61	
    62	                    line = mm.readline()
    63	                    if not line:
    64	                        break
    65	
    66	                    line = line.strip()
    67	                    if not line:  # Skip empty lines
    68	                        current_pos = mm.tell()
    69	                        continue
    70	
    71	                    try:
    72	                        data = orjson.loads(line)
    73	                        linekey = next(iter(data))
    74	                        index_dict[linekey] = current_pos
    75	                    except (orjson.JSONDecodeError, ValueError, StopIteration):
    76	                        print("WARNING: invalid JSON line " + line.decode('utf-8', errors='replace'))
    77	                        continue
    78	
    79	                    current_pos = mm.tell()
    80	
    81	        # Sort and save index
    82	        index_dict = dict(sorted(index_dict.items()))
    83	        with open(index_file_path, 'wb') as f:
    84	            f.write(orjson.dumps(index_dict, option=orjson.OPT_SORT_KEYS))
    85	            
    86	    except OSError as e:
    87	        raise OSError(f"Failed to build index for {jsonl_file_path}: {str(e)}")

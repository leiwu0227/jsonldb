   595	def test_lint_db_force_parameter(db, sample_data):
   596	    """Test that lint_db passes force through to lint_jsonl"""
   597	    _, data_dict = sample_data
   598	    db.upsert_dict("test_table", data_dict)
   599	
   600	    # Append an orphaned line to the underlying file (not in index)
   601	    import orjson
   602	    file_path = db._get_file_path("test_table")
   603	    with open(file_path, 'ab') as f:
   604	        f.write(orjson.dumps({"orphan": {"v": 99}}) + b'\n')
   605	
   606	    # Touch index to appear fresh despite missing the orphan
   607	    os.utime(file_path + ".idx")
   608	
   609	    # force=True: mmap scan detects cardinality mismatch, rebuilds index
   610	    db.lint_db(force=True)
   611	    result = db.get_dict(["test_table"])
   612	    assert "orphan" in result["test_table"]

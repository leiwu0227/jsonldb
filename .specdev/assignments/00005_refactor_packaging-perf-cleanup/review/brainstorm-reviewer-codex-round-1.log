   511	def test_timespec_no_global_contamination(tmp_path, monkeypatch):
   512	    """Opening a microseconds DB must not leak its timespec into other DBs or the global"""
   513	    import jsonldb.jsonlfile as jf
   514	    from jsonldb.jsonlfile import save_jsonl
   515	    monkeypatch.setattr(jf, "TIME_SPEC", "seconds")
   516	
   517	    dir_a = tmp_path / "a"; dir_a.mkdir()
   518	    dir_b = tmp_path / "b"; dir_b.mkdir()
   519	    save_jsonl(str(dir_a / "config.meta"), {"timespec": "microseconds"})
   520	
   521	    db_a = FolderDB(str(dir_a))
   522	    assert db_a.timespec == "microseconds"
   523	    assert jf.TIME_SPEC == "seconds"  # global untouched
   524	
   525	    db_b = FolderDB(str(dir_b))  # fresh DB created afterwards
   526	    assert db_b.timespec == "seconds"
   527	    config_b = select_jsonl(str(dir_b / "config.meta"))
   528	    assert config_b.get("timespec") == "seconds"  # not persisted contamination

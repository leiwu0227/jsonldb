   506	def test_lint_force_detects_orphan_lines(test_file, sample_data):
   507	    """Test that force=True detects orphaned lines via mmap cardinality scan"""
   508	    save_jsonl(test_file, sample_data)
   509	
   510	    # Append an orphaned line (not in index)
   511	    import orjson as _orjson
   512	    with open(test_file, 'ab') as f:
   513	        f.write(_orjson.dumps({"orphan": {"v": 99}}) + b'\n')
   514	
   515	    # Touch index to appear fresh despite missing the orphan entry.
   516	    # This prevents ensure_index_exists() from rebuilding.
   517	    os.utime(test_file + ".idx")

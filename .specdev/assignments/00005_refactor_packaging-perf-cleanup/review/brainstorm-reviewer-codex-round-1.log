   271	    Args:
   272	        linekey_str: String to deserialize
   273	        default_format: Format hint for deserialization ('datetime' supported)
   274	        
   275	    Returns:
   276	        Original type of the linekey (datetime or string)
   277	    """
   278	    if default_format == "datetime":
   279	        return dt.datetime.fromisoformat(linekey_str)
   280	    return linekey_str

   397	def test_load_jsonl_uses_orjson(test_file, sample_data, monkeypatch):
   398	    """Test that load_jsonl works with orjson parsing (bytes input)"""
   399	    save_jsonl(test_file, sample_data)
   400	    # Monkeypatch json.loads to raise — proving orjson is used instead
   401	    import json as json_mod
   402	    original_loads = json_mod.loads
   403	    def patched_loads(*args, **kwargs):
   404	        raise AssertionError("json.loads should not be called during load_jsonl")
   405	    monkeypatch.setattr(json_mod, "loads", patched_loads)
   406	    try:
   407	        loaded = load_jsonl(test_file)
   408	        assert loaded == sample_data
   409	    finally:
   410	        monkeypatch.setattr(json_mod, "loads", original_loads)

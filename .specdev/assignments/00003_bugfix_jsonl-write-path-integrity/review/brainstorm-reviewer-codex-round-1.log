   290	def check_dict_format(data_dict: Dict[Any, Any]) -> bool:
   291	    """Check if a dictionary follows the required JSONL format.
   292	    
   293	    Required format:
   294	    {
   295	        "linekey1": {"value1": 10, "value2": 11},
   296	        "linekey2": {"value1": 11, "value2": 12}
   297	    }
   298	    
   299	    Args:
   300	        data_dict (Dict[str, Any]): Dictionary to check
   301	        
   302	    Returns:
   303	        bool: True if format is valid, False otherwise
   304	        
   305	    Raises:
   306	        ValueError: If format is invalid, with specific error message
   307	    """
   308	    if not isinstance(data_dict, dict):
   309	        raise ValueError("Input must be a dictionary")

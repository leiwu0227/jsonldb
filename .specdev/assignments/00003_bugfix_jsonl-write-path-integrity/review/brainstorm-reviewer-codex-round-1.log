   311	    # if not data_dict:
   312	    #     raise ValueError("Dictionary cannot be empty")
   313	        
   314	    # Check each key-value pair
   315	    for linekey, value in data_dict.items():
   316	        # Check if linekey is a string
   317	        # No need to check if linekey is a string
   318	            
   319	        # Check if value is a dictionary
   320	        if not isinstance(value, dict):
   321	            raise ValueError(f"Value for linekey '{linekey}' must be a dictionary")
   322	            
   323	        # Check if value dictionary is not empty
   324	        if not value:
   325	            raise ValueError(f"Value dictionary for linekey '{linekey}' cannot be empty")
   326	            

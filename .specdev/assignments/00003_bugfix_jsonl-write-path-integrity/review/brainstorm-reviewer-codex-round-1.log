   338	def save_jsonl(jsonl_file_path: str, db_dict: DataDict) -> None:
   339	    """
   340	    Save a dictionary to a JSONL file with automatic indexing.
   341	    
   342	    Efficiently writes records and maintains an index of byte positions.
   343	    Handles empty dictionaries and ensures atomic writes.
   344	    
   345	    Args:
   346	        jsonl_file_path: Path to save the JSONL file
   347	        db_dict: Dictionary of records to save
   348	        
   349	    Raises:
   350	        OSError: If file operations fail
   351	    """
   352	    index: IndexDict = {}
   353	    
   354	    try:
   355	        # Handle empty dictionary case
   356	        if not db_dict:
   357	            with open(jsonl_file_path, 'wb') as f:
   358	                pass  # create empty file
   359	            with open(f"{jsonl_file_path}.idx", 'wb') as f:
   360	                f.write(orjson.dumps({}, option=orjson.OPT_SORT_KEYS))
   361	            return
   362	
   363	        byte_offset = 0
   364	        lines = []
   365	        
   366	        # Pre-process all lines
   367	        for linekey, data in db_dict.items():
   368	            serialized_key = serialize_linekey(linekey)
   369	            line_dict = {serialized_key: data}
   370	            line = _fast_dumps(line_dict).encode('utf-8')
   371	            lines.append(line)
   372	            index[serialized_key] = byte_offset
   373	            byte_offset += len(line)
   374	
   375	        # Write all lines at once
   376	        with open(jsonl_file_path, 'wb', buffering=BUFFER_SIZE) as f:
   377	            for line in lines:
   378	                f.write(line)
   379	
   380	        # Write index atomically
   381	        with open(f"{jsonl_file_path}.idx", 'wb') as f:
   382	            f.write(orjson.dumps(dict(sorted(index.items())), option=orjson.OPT_SORT_KEYS))
   383	            
   384	    except OSError as e:
   385	        raise OSError(f"Failed to save JSONL file {jsonl_file_path}: {str(e)}")

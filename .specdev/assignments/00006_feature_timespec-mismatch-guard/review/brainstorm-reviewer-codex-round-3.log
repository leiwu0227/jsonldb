   606	        """Lint all JSONL files in the database.
   607	
   608	        Args:
   609	            force: If True, run full mmap line-count verification on every file.
   610	                   If False (default), skip the scan when the index is fresh.
   611	        """
   612	        meta_file = os.path.join(self.folder_path, "db.meta")
   613	        if not os.path.exists(meta_file):
   614	            self.build_dbmeta()
   615	
   616	        metadata = select_jsonl(meta_file)
   617	        print(f"Found {len(metadata)} JSONL files to lint.")
   618	
   619	        all_meta = {}
   620	
   621	        for name in metadata:
   622	            print(f"Linting file: {name}")
   623	            file_path = self._get_file_path(name)
   624	            exist_flag = lint_jsonl(file_path, force=force)
   625	
   626	            if not exist_flag:
   627	                print(f"File {name} no longer exist, deleting metadata.")
   628	                # Simply skip — don't add to all_meta
   629	            else:
   630	                all_meta[name] = self._make_meta_entry(
   631	                    name, file_path, linted=True,
   632	                    lint_time=datetime.now().isoformat())
   633	
   634	        # Single write for all metadata
   635	        save_jsonl(self.dbmeta_path, all_meta)
   636	        lint_jsonl(self.dbmeta_path, force=force)
   637	
   638	        if self.use_hierarchy:
   639	            lint_jsonl(self.hmeta_path, force=force)
   640	            self.delete_empty_folders()


def test_timespec_mismatch_mixed_and_camouflage(tmp_path, monkeypatch, capsys):
    """Mixed precision keeps config + warns; boundary-camouflaged mix is untouched"""
    import jsonldb.jsonlfile as jf
    from jsonldb.jsonlfile import save_jsonl
    monkeypatch.setattr(jf, "TIME_SPEC", "seconds")

    # Mixed with a mismatched boundary key: trigger fires, scan finds both -> keep + warn
    d1 = tmp_path / "mixed"; d1.mkdir()
    save_jsonl(str(d1 / "t.jsonl"), {
        "2024-01-01T00:00:00": {"v": 1},
        "2024-01-02T00:00:00.123456": {"v": 2},  # max boundary, microseconds
    })
    save_jsonl(str(d1 / "config.meta"), {"timespec": "seconds"})
    db1 = FolderDB(str(d1))
    assert db1.timespec == "seconds"
    assert select_jsonl(str(d1 / "config.meta")).get("timespec") == "seconds"
    assert "mixed datetime key precisions" in capsys.readouterr().out

    # Boundary camouflage: min/max match config, interior key is microseconds ->
    # no trigger, no rewrite, interior key stays a string (documented limitation)
    d2 = tmp_path / "camo"; d2.mkdir()
    save_jsonl(str(d2 / "t.jsonl"), {
        "2024-01-01T00:00:00": {"v": 1},
        "2024-01-01T00:30:00.123456": {"v": 2},  # interior, microseconds
        "2024-01-01T01:00:00": {"v": 3},
    })
    save_jsonl(str(d2 / "config.meta"), {"timespec": "seconds"})
    db2 = FolderDB(str(d2))
    assert db2.timespec == "seconds"
    assert select_jsonl(str(d2 / "config.meta")).get("timespec") == "seconds"
    loaded = db2.get_dict(["t"])["t"]
    assert "2024-01-01T00:30:00.123456" in loaded  # stays a string


def test_timespec_no_global_contamination(tmp_path, monkeypatch):
    """Opening a microseconds DB must not leak its timespec into other DBs or the global"""
    import jsonldb.jsonlfile as jf
    from jsonldb.jsonlfile import save_jsonl
    monkeypatch.setattr(jf, "TIME_SPEC", "seconds")

    dir_a = tmp_path / "a"; dir_a.mkdir()
    dir_b = tmp_path / "b"; dir_b.mkdir()
    save_jsonl(str(dir_a / "config.meta"), {"timespec": "microseconds"})

    db_a = FolderDB(str(dir_a))
    assert db_a.timespec == "microseconds"
    assert jf.TIME_SPEC == "seconds"  # global untouched

    db_b = FolderDB(str(dir_b))  # fresh DB created afterwards
    assert db_b.timespec == "seconds"
    config_b = select_jsonl(str(dir_b / "config.meta"))
    assert config_b.get("timespec") == "seconds"  # not persisted contamination

def test_two_dbs_different_timespecs_round_trip(tmp_path, monkeypatch):
    """Two DBs with different timespecs must round-trip datetime keys independently"""
    import jsonldb.jsonlfile as jf
    from jsonldb.jsonlfile import save_jsonl
    monkeypatch.setattr(jf, "TIME_SPEC", "seconds")

    dir_us = tmp_path / "us"; dir_us.mkdir()
    dir_s = tmp_path / "s"; dir_s.mkdir()
    save_jsonl(str(dir_us / "config.meta"), {"timespec": "microseconds"})

    db_us = FolderDB(str(dir_us))
    db_s = FolderDB(str(dir_s))

    key_us = datetime(2024, 1, 1, 12, 0, 0, 123456)
    key_s = datetime(2024, 1, 1, 12, 0, 0)
    db_us.upsert_dict("t", {key_us: {"v": 1}})
    db_s.upsert_dict("t", {key_s: {"v": 2}})

    assert db_us.get_dict(["t"])["t"] == {key_us: {"v": 1}}
    assert db_s.get_dict(["t"])["t"] == {key_s: {"v": 2}}

def test_init_does_not_rewrite_configmeta_if_unchanged(db_folder):
    """Test that __init__ skips config.meta rewrite when value unchanged"""
    db = FolderDB(db_folder)
    config_path = os.path.join(db_folder, "config.meta")

    # Read content after first init
    with open(config_path, 'rb') as f:
        content_before = f.read()
    size_before = os.path.getsize(config_path)

    # Re-init — should not rewrite (verify via content identity)
    db2 = FolderDB(db_folder)

    with open(config_path, 'rb') as f:
        content_after = f.read()

    assert content_before == content_after


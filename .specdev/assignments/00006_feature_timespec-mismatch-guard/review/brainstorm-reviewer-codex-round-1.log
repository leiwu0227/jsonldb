# Update Tests
def test_update_existing_records(test_file, sample_data):
    """Test updating existing records with same size data"""
    save_jsonl(test_file, sample_data)
    
    # Update existing records
    updates = {
        "key1": {"value": 10, "name": "updated1"},
        "key2": {"value": 20, "name": "updated2"}
    }
    update_jsonl(test_file, updates)
    
    # Verify updates
    loaded_data = load_jsonl(test_file)
    assert loaded_data["key1"]["value"] == 10
    assert loaded_data["key2"]["name"] == "updated2"
    assert loaded_data["key3"] == sample_data["key3"]  # Unchanged

def test_update_with_larger_data(test_file, sample_data):
    """Test updating records with larger data that won't fit in place"""
    save_jsonl(test_file, sample_data)
    
    # Update with larger data
    updates = {
        "key1": {
            "value": 10,
            "name": "updated1",
            "extra": "this makes the record larger"
        }
    }
    update_jsonl(test_file, updates)
    
    # Verify updates
    loaded_data = load_jsonl(test_file)
    assert loaded_data["key1"]["extra"] == "this makes the record larger"
    assert loaded_data["key2"] == sample_data["key2"]  # Unchanged

def test_update_with_new_records(test_file, sample_data):
    """Test adding new records via update"""
    save_jsonl(test_file, sample_data)
    
    # Add new records
    updates = {
        "key4": {"value": 4, "name": "test4"},
        "key5": {"value": 5, "name": "test5"}
    }
    update_jsonl(test_file, updates)
    
    # Verify updates
    loaded_data = load_jsonl(test_file)
    assert len(loaded_data) == 5
    assert loaded_data["key4"]["value"] == 4
    assert loaded_data["key5"]["name"] == "test5"

def test_update_append_heals_missing_trailing_newline(test_file):
    """Appending must not concatenate onto a last line that lacks a trailing newline"""
    with open(test_file, 'wb') as f:
        f.write(b'{"a":{"v":1}}')  # no trailing newline

    update_jsonl(test_file, {"b": {"v": 2}})

    loaded_data = load_jsonl(test_file)
    assert loaded_data == {"a": {"v": 1}, "b": {"v": 2}}

def test_update_shrink_keeps_line_terminator(test_file):
    """Shrinking a record in place must keep every line newline-terminated"""
    save_jsonl(test_file, {"a": {"v": "xxxxxxxxxxxxxxxxxxxx"}, "b": {"v": 2}})

    update_jsonl(test_file, {"a": {"v": 1}})  # much shorter record

    with open(test_file, 'rb') as f:
        raw = f.read()
    # Every line (including the padded one) must end with a newline, so the
    # padding must not merge into record b's line.
    lines = raw.split(b'\n')
    assert lines[-1] == b''  # file ends with newline
    record_lines = [l for l in lines[:-1] if l.strip()]
    assert record_lines[0].rstrip(b' ') == b'{"a":{"v":1}}'  # padding stays on its own line
    assert record_lines[1] == b'{"b":{"v":2}}'

    # Rebuilt index must point at real record starts (not padding)
    build_jsonl_index(test_file)
    with open(test_file + '.idx', 'rb') as f:
        index = json.loads(f.read())
    for key, offset in index.items():
        assert raw[offset:offset + 1] == b'{'

    assert load_jsonl(test_file) == {"a": {"v": 1}, "b": {"v": 2}}

def test_explicit_timespec_round_trip(test_file):

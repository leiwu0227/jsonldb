    key = datetime(2024, 1, 1, 12, 0, 0, 123456)

    save_jsonl(test_file, {key: {"v": 1}}, timespec="microseconds")
    loaded = load_jsonl(test_file, timespec="microseconds")

    assert loaded == {key: {"v": 1}}
    assert jf.TIME_SPEC == "seconds"  # module global untouched


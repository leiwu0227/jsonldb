   591	    original_update = db.update_dbmeta
   592	    def counting_update(*args, **kwargs):
   593	        nonlocal call_count
   594	        call_count += 1
   595	        return original_update(*args, **kwargs)
   596	    db.update_dbmeta = counting_update
   597	
   598	    db.lint_db()
